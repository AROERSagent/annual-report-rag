# ===== 大模型配置（必填）=====
# 去 https://platform.deepseek.com 注册，在「API Keys」里创建，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=
# 下面两项留空会用代码里的默认值，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 向量模型（本地运行，无需配置）=====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 检索与分块参数（可选，调优用）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
COLLECTION_NAME=annual_reports

# ===== 检索模式（可选，阶段 5 的消融实验开关）=====
# 实测 30 题评测集的结果（详见 README 消融实验表）：
#   vector        = 只用向量检索            Recall@5 = 65%   延迟 1.11s
#   hybrid        = 向量 + BM25 + RRF 融合  Recall@5 = 85%   延迟 1.12s  ← 推荐
#   hybrid_rerank = 再加交叉编码器精排       Recall@5 = 90%   延迟 3.77s
RETRIEVAL_MODE=hybrid

# 每种检索各取多少候选参与融合（取大一点再融合，效果更好）
CANDIDATE_K=20
# RRF 平滑常数，业界经验值 60
RRF_K=60

# ===== 重排模型（仅 hybrid_rerank 模式需要，约 1GB，首次自动下载）=====
# 想省空间可以换成 BAAI/bge-reranker-v2-m3-int8（约 0.57GB）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=20
